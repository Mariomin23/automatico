# ── IA ────────────────────────────────────────────────
# Local: Ollama (sin coste, corre en tu máquina)
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Producción (Vercel): Groq — free tier, sin tarjeta.
# Crea la key en https://console.groq.com/keys
# Si GROQ_API_KEY existe, se usa Groq en vez de Ollama.
# GROQ_API_KEY=gsk_xxxx
# GROQ_MODEL=llama-3.1-8b-instant

# ── InfoJobs API oficial (developer.infojobs.net) ─────
INFOJOBS_CLIENT_ID=xxxx
INFOJOBS_CLIENT_SECRET=xxxx

# ── Email (opcional) ──────────────────────────────────
EMAIL_FROM=mario@minuesa.es
EMAIL_TO=mario@minuesa.es
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=mario@minuesa.es
EMAIL_SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# ── Configuración ─────────────────────────────────────
MAX_OFFERS_PER_RUN=20

# ── Vercel Blob (solo producción; Vercel la inyecta sola) ──
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxx

# ── Seguridad (producción) ────────────────────────────
# Protege búsquedas, cartas y CRM en el dashboard público.
# Genera uno: openssl rand -hex 16
# ADMIN_TOKEN=xxxx
